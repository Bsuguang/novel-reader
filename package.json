{
  "name": "novel-reader",
  "version": "1.0.0",
  "description": "本地 TXT 小说阅读器（基于 novelReader 架构二次开发，V1）",
  "main": "main.js",
  "scripts": {
    "build": "webpack --mode production",
    "start": "webpack --mode production && electron .",
    "dev": "webpack --mode development --watch",
    "test": "node test/lib.test.js",
    "dist": "node scripts/dist.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "style-loader": "^3.3.4",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "build": {
    "appId": "com.novelreader.app",
    "productName": "小说阅读器",
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "index.html",
      "pet.html",
      "pet.js",
      "dist/**/*",
      "src/lib/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.books",
      "darkModeSupport": true,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "文本文件",
            "CFBundleTypeRole": "Viewer",
            "LSItemContentTypes": ["public.plain-text", "net.daringfireball.markdown"]
          }
        ]
      }
    }
  }
}
